import json
from typing import Dict, Any

def parse_catalog_to_dense_format(input_filepath: str, output_filepath: str) -> None:
    """
    Parses a loose JSONL catalog, extracts critical fields, and outputs a dense string format.
    Safely handles missing fields and variable data types (strings vs lists).
    """
    with open(input_filepath, 'r', encoding='utf-8') as infile, \
         open(output_filepath, 'w', encoding='utf-8') as outfile:
        
        for line in infile:
            if not line.strip():
                continue
                
            try:
                item: Dict[str, Any] = json.loads(line)
            except json.JSONDecodeError:
                continue
                
            # parent_asin is critical for scoring; skip if missing
            parent_asin = item.get('parent_asin', '').strip()
            if not parent_asin:
                continue 
                
            title = item.get('title', 'Unknown Title')
            if isinstance(title, list):
                title = " ".join(title)
            
            # Descriptions in Amazon datasets are often lists of strings
            raw_desc = item.get('description', '')
            description = " ".join(raw_desc) if isinstance(raw_desc, list) else str(raw_desc)
            
            # Features are often stored under 'features' or 'bullet_point'
            raw_features = item.get('features', item.get('bullet_point', ''))
            features = " ".join(raw_features) if isinstance(raw_features, list) else str(raw_features)
            
            # Construct the dense string, ignoring empty fields
            dense_parts = [f"Title: {title.strip()}"]
            
            if description.strip():
                dense_parts.append(f"Description: {description.strip()}")
            if features.strip():
                dense_parts.append(f"Features: {features.strip()}")
                
            dense_string = " ".join(dense_parts)
                
            # Output a new JSONL structure ready for vector embedding
            processed_item = {
                "parent_asin": parent_asin,
                "dense_text": dense_string
            }
            
            outfile.write(json.dumps(processed_item) + '\n')

if __name__ == "__main__":
    # Example usage:
    # parse_catalog_to_dense_format('catalog.jsonl', 'parsed_catalog.jsonl')
    pass